1 24 "app.manifest"

#include "orbit-version.h"

1 VERSIONINFO
 FILEVERSION ORBIT_VERSION_NUM
 PRODUCTVERSION ORBIT_VERSION_NUM
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "CompanyName", "azukihoney\0"
            VALUE "FileDescription", "Orbit Launcher\0"
            VALUE "FileVersion", ORBIT_VERSION
            VALUE "InternalName", "orbit-launcher.exe\0"
            VALUE "LegalCopyright", "azukihoney\0"
            VALUE "OriginalFilename", "orbit-launcher.exe\0"
            VALUE "ProductName", "Orbit Launcher\0"
            VALUE "ProductVersion", ORBIT_VERSION
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END
